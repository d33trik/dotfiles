# Set the $mod variable to the super key
set $mod Mod4

# Font for window titles and the status bar
font pango:SauceCodePro Nerd Font 10

# Propagate X11 display variables to systemd user environmen
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY

# Set desktop environment identifier for xdg-desktop-portal backend
exec --no-startup-id systemctl --user set-environment XDG_CURRENT_DESKTOP=i3

# Re-apply US International layout so kanata uinput gets dead keys
exec_always --no-startup-id setxkbmap us -variant intl

# Start dunst, a lightweight notification daemon
exec --no-startup-id dunst

# Set wallpaper
exec --no-startup-id feh --no-fehbg --bg-fill --randomize ~/.wallpapers/*

# Toggle notifications pause
bindsym $mod+q exec dunstctl set-paused toggle

# Close all active notifications
bindsym $mod+n exec dunstctl close-all

# Re-open closed notifications
bindsym $mod+Shift+n exec dunstctl history-pop

# Use pactl to adjust volume in PulseAudio
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use the Mod key to move/resize floating windows with the mouse
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking into the window
# while holding the floating modifier
tiling_drag modifier titlebar

# Start a terminal
bindsym $mod+Return exec alacritty

# Close the currently focused window
bindsym $mod+Shift+q kill

# Launch rofi
bindsym $mod+d exec --no-startup-id rofi -show drun

# Vim-style window focus navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Disable window focus when hovering the mouse
focus_follows_mouse no

# Vim-style focused window moving
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split container in horizontal orientation
bindsym $mod+Ctrl+h split v

# Split container in vertical orientation
bindsym $mod+Ctrl+v split h

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Focus the parent container
bindsym $mod+p focus parent

# focus the child container
bindsym $mod+c focus child

# Workspace name variables for cleaner workspace keybindings
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Set i3lock variable
set $i3lock i3lock -c 222436

# Lock screen
bindsym $mod+Shift+x exec --no-startup-id $i3lock

# Auto-lock screen on sleep/suspend using i3lock
exec --no-startup-id xss-lock --transfer-sleep-lock -- $i3lock --nofork

# Lock shutdown and reboot menu
set $mode_system shutdown (1), reboot (2), logout (3), suspend (4), hibernate (5)

mode "$mode_system" {
	bindsym 1 exec --no-startup-id systemctl poweroff -i, mode "default"
	bindsym 2 exec --no-startup-id systemctl reboot, mode "default"
	bindsym 3 exec --no-startup-id i3-msg exit, mode "default"
	bindsym 4 exec --no-startup-id $i3lockwall && systemctl suspend, mode "default"
	bindsym 5 exec --no-startup-id $i3lockwall && systemctl hibernate, mode "default"
	
	# to close the menu: Enter or Escape
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+BackSpace mode "$mode_system"

# Resize window (you can also use the mouse for that)
mode "resize" {
	# Pressing left will shrink the window’s width.
	bindsym h resize shrink width 10 px or 10 ppt

	# Pressing down will grow the window’s height.
	bindsym j resize grow height 10 px or 10 ppt

	# Pressing up will shrink the window’s height.
	bindsym k resize shrink height 10 px or 10 ppt

	# Pressing right will grow the window’s width.
	bindsym l resize grow width 10 px or 10 ppt

	# Back to normal mode
	bindsym Return mode "default"
	bindsym Escape mode "default"
	bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Remove title bars in split layouts
default_border pixel 3

# Gap between windwos
gaps inner 15

# Gap between window and screen edge
gaps outer 0

# Remove gaps when only one container is visible
smart_gaps on

# Colors
set $background_0 #16161e
set $background_1 #1a1b26
set $foreground_0 #a9b1d6
set $foreground_1 #c0caf5
set $red          #f7768e

#                       border        background    text          indicator     child_border
client.focused          $foreground_1 $foreground_1 $background_0 $foreground_1 $foreground_1
client.focused_inactive $background_0 $background_0 $foreground_1 $background_0 $background_0
client.unfocused        $background_0 $background_0 $foreground_1 $background_0 $background_0
client.urgent           $red          $red          $background_0 $red          $red

# Start i3bar
bar {
	status_command i3status --config ~/.config/i3/i3status.conf
	separator_symbol " | "

	colors {
		background $background_0
		statusline $foreground_1
		separator  $foreground_1

#                       border        background    text
		focused_workspace   $foreground_1 $foreground_1 $background_0
		active_workspace    $foreground_0 $foreground_0 $background_0
		inactive_workspace  $background_0 $background_0 $foreground_1
		urgent_workspace    $red          $red          $background_0
	}
}
