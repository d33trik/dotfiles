[global]

# Set font type and size
font = "SauceCodePro Nerd Font 12"

# Displays icons on the left side of notifications
icon_position = "left"

# Enable markup
markup = "full"

# Define the layout of the notification
format = "<b>%s</b>\n%b"

# Aligns the text in notifications to the left
alignment = "left"

# Enables line wrapping instead of cutting off long lines
word_wrap = "true"

# Keeps newline characters instead of removing them
ignore_newline = "false"

# Set line height to font default
line_height = 0

# Thickness of the horizontal separator between stacked notifications
separator_height = 2

# Adds space between text and the notification border
padding = 8

# Controls left/right spacing inside the notification
horizontal_padding = 8

# Width of the notification border
frame_width = 1

# Uses the frame color fot the separator line
separator_color= "frame"

# Sort notifications by time so older ones appear first
sort = "true"

# Show a indicator if there are hidden notification
indicate_hidden = "true"

# If a notification is older than 60 seconds, display its age
show_age_threshold = 60

# Combine repeated notifications instead of showing them individually
stack_duplicates = "true"

# Disables idle detection
idle_threshold = 0

# Display notification only on the first monitor
monitor = 0

# Notification will follow the monitor where the keyboard focus is
follow = "keyboard"

# Allows you to view old notification
sticky_history = "true"

# Max width of a notification in pixels
width = 300

# Max height of a notification in pixelx
height = (0, 300)

# No offset from the edge of the screen
offset = (0, 0)

# Sets the screen corner for notifications
origin = "top-right"

# Opacity of notifications (0 = opaque, 100 = fully transparent)
transparency = 0

# Sets which dmenu command to use when invoking Dunst’s history with shortcuts
dmenu = "/usr/bin/dmenu -p dunst"

# Tokyo Night Moon colors for dunst
[urgency_low]
background = "#1e2030"
foreground = "#c8d3f5"
frame_color = "#c8d3f5"
timeout = 10

[urgency_normal]
background = "#1e2030"
foreground = "#c8d3f5"
frame_color = "#c8d3f5"
timeout = 15

[urgency_critical]
background = "#1e2030"
foreground = "#ff757f"
frame_color = "#ff757f"
timeout = 30
